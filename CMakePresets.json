{
  "version": 3,
  "configurePresets": [
    {
      "name": "android-arm64",
      "generator": "Ninja",
      "binaryDir": "build/android-arm64",
      "toolchainFile": "$ENV{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
